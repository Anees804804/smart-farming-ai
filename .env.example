# Server
PORT=5000
NODE_ENV=development

# Production frontend URL for CORS (e.g. https://yourdomain.com)
CLIENT_URL=

# Database
MONGODB_URI=mongodb://localhost:27017/smart-farming-ai

# AI / LLM
GROQ_API_KEY=
GROQ_MODEL=
# Vision model for crop image observation (current default fallback)
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Audio transcription model for voice input (current default fallback)
GROQ_WHISPER_MODEL=whisper-large-v3

# Weather
OPENWEATHER_API_KEY=

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Client
VITE_API_URL=http://localhost:5000/api

# ML Service (Python)
HF_MODEL_NAME=
MAX_IMAGE_SIZE_MB=5
DISEASE_CONFIDENCE_THRESHOLD=0.6

# Admin
ADMIN_KEY=
